<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم مطعم الريان - النسخة الشاملة</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
        body { background: #f8fafc; padding: 20px; }

        #login-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(14, 26, 53, 0.97);
            display: flex; align-items: center; justify-content: center;
            z-index: 9999;
        }
        .login-box {
            background: white; padding: 40px 30px; border-radius: 25px;
            width: 90%; max-width: 400px; text-align: center;
            box-shadow: 0 25px 50px rgba(0,0,0,0.4);
        }
        .login-box h2 { color: #0e1a35; margin-bottom: 10px; font-size: 24px; font-weight: 900; }
        .login-box p { color: #64748b; margin-bottom: 25px; font-size: 14px; }
        .login-box input {
            width: 100%; padding: 15px; border: 2px solid #e2e8f0;
            border-radius: 15px; font-size: 18px; text-align: center;
            margin-bottom: 20px; outline: none; transition: 0.3s;
        }
        .login-box input:focus { border-color: #c5a02a; box-shadow: 0 0 0 4px rgba(197, 160, 42, 0.15); }
        .login-box button {
            background: #0e1a35; color: white; border: none;
            padding: 15px; border-radius: 15px; font-weight: 800;
            font-size: 18px; cursor: pointer; width: 100%;
        }
        .login-error { color: #ef4444; font-weight: 700; margin-top: 10px; display: none; }

        .container { max-width: 1100px; margin: auto; }
        .header { background: #0e1a35; color: white; padding: 20px; border-radius: 15px; text-align: center; margin-bottom: 25px; }
        .header h1 { font-size: 24px; }
        .notice { background: #fef3c7; border: 1px solid #f59e0b; padding: 15px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; line-height: 1.6; }
        .file-area { background: white; border: 2px dashed #cbd5e1; border-radius: 15px; padding: 40px; text-align: center; margin-bottom: 20px; cursor: pointer; transition: 0.3s; }
        .file-area:hover { border-color: #c5a02a; background: #fffbeb; }
        .file-area input { display: none; }

        .ticker-section { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .ticker-section h2 { color: #0e1a35; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 15px; }
        .ticker-input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 10px; font-size: 15px; font-weight: 600; }

        .section { background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .section-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 15px; }
        .section-header .category-name-input {
            padding: 8px 12px; border: 1px solid #ddd; border-radius: 10px;
            font-size: 18px; font-weight: 700; color: #0e1a35;
            width: 60%;
        }
        .section-header .actions { display: flex; gap: 5px; }
        .btn-move { background: #e2e8f0; border: none; width: 35px; height: 35px; border-radius: 8px; cursor: pointer; font-size: 16px; font-weight: bold; }
        .btn-move:hover { background: #cbd5e1; }
        .btn-delete-category { background: #ef4444; color: white; border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-weight: 700; }

        .item-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 15px 0; border-bottom: 1px solid #f1f5f9; }
        .item-row:last-child { border-bottom: none; }
        .item-fields { display: flex; flex-wrap: wrap; gap: 10px; flex: 1; }
        .item-fields input[type="text"], .item-fields input[type="number"] {
            padding: 10px; border: 1px solid #ddd; border-radius: 10px;
            font-size: 14px; font-weight: 700; width: 180px;
        }
        .item-fields .desc-input { width: 250px; }
        .item-fields .img-input { width: 250px; }
        .img-preview { width: 60px; height: 60px; border-radius: 10px; object-fit: cover; border: 1px solid #ddd; }
        .btn-delete-item { background: #ef4444; color: white; border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-weight: 700; }
        .btn-add-item { background: #e2e8f0; color: #0e1a35; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; font-weight: 700; margin-top: 10px; }
        .btn-add-item:hover { background: #cbd5e1; }
        .item-move-btns { display: flex; gap: 5px; }

        .btn-save { background: #10b981; color: white; border: none; padding: 15px 30px; border-radius: 12px; font-size: 18px; font-weight: 800; cursor: pointer; width: 100%; margin-top: 20px; }
        .btn-copy { background: #0e1a35; color: white; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 700; cursor: pointer; margin-top: 10px; width: 100%; }
        .btn-add-category { background: #0e1a35; color: white; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 700; cursor: pointer; margin-top: 20px; width: 100%; }
        .save-status { text-align: center; margin-top: 15px; font-weight: 700; color: #10b981; display: none; }

        .input-error {
            border-color: #ef4444 !important;
            background: #fef2f2 !important;
        }
        .error-message {
            color: #ef4444;
            font-weight: 700;
            font-size: 14px;
            margin-top: 10px;
            display: none;
        }
    </style>
</head>
<body>

    <!-- شاشة الدخول -->
    <div id="login-overlay">
        <div class="login-box">
            <h2>🔐 دخول المشرف</h2>
            <p>لوحة التحكم الشاملة</p>
            <input type="password" id="admin-password" placeholder="كلمة المرور">
            <button onclick="checkPassword()">دخول</button>
            <div class="login-error" id="login-error">❌ كلمة المرور غير صحيحة</div>
        </div>
    </div>

    <!-- محتوى اللوحة -->
    <div class="container" id="admin-content" style="display: none;">
        <div class="header">
            <h1>🍽️ لوحة تحكم مطعم الريان الشاملة</h1>
        </div>

        <div class="notice">
            ⚠️ <strong>طريقة الاستخدام:</strong> اختر ملف <code>menu.json</code> من جهازك، عدّل الأصناف والأقسام بحرية، ثم اضغط حفظ لتنزيل الملف المعدّل وارفعه إلى GitHub.
            <br>📌 لتعديل صورة صنف: ضع رابط الصورة (مثل <code>images/shawarma.jpg</code>) أو رابط خارجي، وسيتم عرض معاينة.
            <br>✅ <strong>ميزة الحفظ التلقائي:</strong> يتم حفظ تعديلاتك تلقائياً في هذا المتصفح. إذا أغلقت الصفحة بالخطأ، افتحها مرة أخرى وستستعيد بياناتك.
            <br>⚠️ <strong>تحذير:</strong> لن يتم الحفظ أو التنزيل إذا وُجد سعر فارغ.
        </div>

        <label class="file-area" id="file-area">
            📂 <strong>اضغط هنا لاختيار ملف menu.json من جهازك</strong>
            <input type="file" id="file-input" accept=".json">
        </label>

        <!-- قسم شريط الأخبار -->
        <div class="ticker-section" id="ticker-section" style="display:none;">
            <h2>📰 شريط الأخبار</h2>
            <input type="text" id="ticker-text" class="ticker-input" placeholder="اكتب نص الشريط هنا...">
        </div>

        <div id="content" style="display:none;"></div>

        <button class="btn-add-category" id="add-category-btn" style="display:none;">➕ إضافة قسم جديد</button>
        <button class="btn-save" id="save-btn" style="display:none;">💾 حفظ وتنزيل menu.json</button>
        <button class="btn-copy" id="copy-btn" style="display:none;">📋 نسخ كود JSON للحافظة</button>
        <div class="save-status" id="save-status">✅ تم الحفظ تلقائياً في المتصفح</div>
        <div class="error-message" id="error-message">⚠️ لا يمكن الحفظ: توجد خانات سعر فارغة. الرجاء تعبئة جميع الأسعار.</div>
    </div>

    <script>
        // كلمة المرور
        const ADMIN_PASSWORD = "hussein";
        const STORAGE_KEY = 'rayyan_admin_autosave';

        function checkPassword() {
            const input = document.getElementById('admin-password');
            const error = document.getElementById('login-error');
            if (input.value === ADMIN_PASSWORD) {
                sessionStorage.setItem('rayyan_admin_logged', 'true');
                showAdminPanel();
            } else {
                error.style.display = 'block';
                input.value = '';
                input.focus();
            }
        }

        function showAdminPanel() {
            document.getElementById('login-overlay').style.display = 'none';
            document.getElementById('admin-content').style.display = 'block';
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    menuData = JSON.parse(saved);
                    if (Array.isArray(menuData)) {
                        tickerText = '';
                        renderForm(menuData);
                    } else if (menuData && typeof menuData === 'object') {
                        tickerText = menuData.ticker_text || '';
                        renderForm(menuData.categories || []);
                    }
                    showStatus('✅ تم استعادة آخر جلسة محفوظة تلقائياً');
                    return;
                } catch(e) {}
            }
            showStatus('');
        }

        if (sessionStorage.getItem('rayyan_admin_logged') === 'true') {
            showAdminPanel();
        }

        let menuData = [];        // الأقسام فقط
        let tickerText = '';      // نص شريط الأخبار

        const fileInput = document.getElementById('file-input');
        fileInput.addEventListener('change', handleFileSelect);

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (Array.isArray(parsed)) {
                        // البنية القديمة (مصفوفة أقسام فقط)
                        menuData = parsed;
                        tickerText = '';
                    } else if (parsed && typeof parsed === 'object' && parsed.categories) {
                        // البنية الجديدة (كائن يحتوي على ticker_text و categories)
                        menuData = parsed.categories;
                        tickerText = parsed.ticker_text || '';
                    } else {
                        alert('الملف غير صالح');
                        return;
                    }
                    renderForm(menuData);
                } catch (error) {
                    alert('عذراً، الملف ليس JSON صحيح أو بنيته غير سليمة.');
                }
            };
            reader.readAsText(file);
        }

        function renderForm(data) {
            const container = document.getElementById('content');
            container.innerHTML = '';
            container.style.display = 'block';

            // إظهار قسم الشريط
            document.getElementById('ticker-section').style.display = 'block';
            document.getElementById('ticker-text').value = tickerText;
            document.getElementById('ticker-text').addEventListener('input', function() {
                tickerText = this.value;
                autoSave();
            });

            // عرض الأقسام
            data.forEach((cat, catIdx) => {
                const section = document.createElement('div');
                section.className = 'section';

                const header = document.createElement('div');
                header.className = 'section-header';
                header.innerHTML = `
                    <input type="text" class="category-name-input" value="${cat.category}" data-cat-index="${catIdx}" placeholder="اسم القسم">
                    <div class="actions">
                        <button class="btn-move" onclick="moveCategory(${catIdx}, -1)" title="تحريك لأعلى">▲</button>
                        <button class="btn-move" onclick="moveCategory(${catIdx}, 1)" title="تحريك لأسفل">▼</button>
                        <button class="btn-delete-category" onclick="deleteCategory(${catIdx})">🗑️ حذف</button>
                    </div>
                `;
                section.appendChild(header);

                const nameInput = header.querySelector('.category-name-input');
                nameInput.addEventListener('input', function() {
                    menuData[catIdx].category = this.value;
                    autoSave();
                });

                const itemsDiv = document.createElement('div');
                itemsDiv.className = 'items-container';

                cat.items.forEach((item, itemIdx) => {
                    itemsDiv.appendChild(createItemRow(catIdx, itemIdx, item));
                });

                section.appendChild(itemsDiv);

                const addItemBtn = document.createElement('button');
                addItemBtn.className = 'btn-add-item';
                addItemBtn.textContent = `➕ إضافة صنف إلى ${cat.category}`;
                addItemBtn.onclick = () => addItem(catIdx);
                section.appendChild(addItemBtn);

                container.appendChild(section);
            });

            document.getElementById('save-btn').style.display = 'block';
            document.getElementById('copy-btn').style.display = 'block';
            document.getElementById('add-category-btn').style.display = 'block';
        }

        function createItemRow(catIdx, itemIdx, item) {
            const row = document.createElement('div');
            row.className = 'item-row';
            row.innerHTML = `
                <div class="item-fields">
                    <input type="text" placeholder="اسم الصنف" value="${item.name}" data-field="name" data-cat="${catIdx}" data-item="${itemIdx}">
                    <input type="text" placeholder="الوصف" class="desc-input" value="${item.desc || ''}" data-field="desc" data-cat="${catIdx}" data-item="${itemIdx}">
                    <input type="number" placeholder="السعر" value="${item.price !== null && item.price !== undefined ? item.price : ''}" data-field="price" data-cat="${catIdx}" data-item="${itemIdx}" step="0.5" min="0">
                    <input type="text" placeholder="رابط الصورة" class="img-input" value="${item.img || ''}" data-field="img" data-cat="${catIdx}" data-item="${itemIdx}" oninput="updatePreview(this)">
                </div>
                <img src="${item.img || ''}" class="img-preview" onerror="this.style.display='none'">
                <div class="item-move-btns">
                    <button class="btn-move" onclick="moveItem(${catIdx}, ${itemIdx}, -1)" title="تحريك لأعلى">▲</button>
                    <button class="btn-move" onclick="moveItem(${catIdx}, ${itemIdx}, 1)" title="تحريك لأسفل">▼</button>
                </div>
                <button class="btn-delete-item" onclick="deleteItem(${catIdx}, ${itemIdx})">🗑️</button>
            `;

            row.querySelectorAll('input').forEach(input => {
                input.addEventListener('input', () => {
                    const field = input.dataset.field;
                    const cat = parseInt(input.dataset.cat);
                    const item = parseInt(input.dataset.item);
                    if (field === 'price') {
                        const priceValue = input.value.trim();
                        if (priceValue === '') {
                            menuData[cat].items[item].price = null;
                            input.classList.add('input-error');
                        } else {
                            menuData[cat].items[item].price = parseFloat(priceValue) || 0;
                            input.classList.remove('input-error');
                        }
                    } else {
                        menuData[cat].items[item][field] = input.value;
                    }
                    if (validatePrices()) {
                        autoSave();
                        hideError();
                    } else {
                        showError();
                    }
                });
            });

            const priceInput = row.querySelector('input[data-field="price"]');
            if (priceInput && (item.price === null || item.price === undefined || item.price === '')) {
                priceInput.classList.add('input-error');
            }

            return row;
        }

        function updatePreview(input) {
            const row = input.closest('.item-row');
            const img = row.querySelector('.img-preview');
            img.src = input.value;
            img.style.display = 'block';
        }

        function addItem(catIdx) {
            const newItem = {
                id: Date.now(),
                name: '',
                desc: '',
                price: null,
                img: ''
            };
            menuData[catIdx].items.push(newItem);
            renderForm(menuData);
            showError();
        }

        function deleteItem(catIdx, itemIdx) {
            if (confirm('هل تريد حذف هذا الصنف؟')) {
                menuData[catIdx].items.splice(itemIdx, 1);
                renderForm(menuData);
                if (validatePrices()) autoSave();
                else showError();
            }
        }

        function moveItem(catIdx, itemIdx, direction) {
            const items = menuData[catIdx].items;
            const newIndex = itemIdx + direction;
            if (newIndex < 0 || newIndex >= items.length) return;
            [items[itemIdx], items[newIndex]] = [items[newIndex], items[itemIdx]];
            renderForm(menuData);
            if (validatePrices()) autoSave();
            else showError();
        }

        function deleteCategory(catIdx) {
            if (confirm('هل تريد حذف هذا القسم بالكامل؟')) {
                menuData.splice(catIdx, 1);
                renderForm(menuData);
                if (validatePrices()) autoSave();
                else showError();
            }
        }

        function moveCategory(catIdx, direction) {
            const newIndex = catIdx + direction;
            if (newIndex < 0 || newIndex >= menuData.length) return;
            [menuData[catIdx], menuData[newIndex]] = [menuData[newIndex], menuData[catIdx]];
            renderForm(menuData);
            if (validatePrices()) autoSave();
            else showError();
        }

        document.getElementById('add-category-btn').addEventListener('click', () => {
            const newCategory = {
                category: 'اسم القسم الجديد',
                items: []
            };
            menuData.push(newCategory);
            renderForm(menuData);
            if (validatePrices()) autoSave();
            else showError();
        });

        function validatePrices() {
            for (let cat of menuData) {
                for (let item of cat.items) {
                    if (item.price === null || item.price === undefined || item.price === '' || isNaN(item.price)) {
                        return false;
                    }
                }
            }
            return true;
        }

        function showError() {
            document.getElementById('error-message').style.display = 'block';
            document.getElementById('save-status').style.display = 'none';
        }

        function hideError() {
            document.getElementById('error-message').style.display = 'none';
        }

        function showStatus(message) {
            const status = document.getElementById('save-status');
            if (message) {
                status.textContent = message;
                status.style.display = 'block';
                setTimeout(() => { status.style.display = 'none'; }, 3000);
            } else {
                status.style.display = 'none';
            }
        }

        function autoSave() {
            const dataToSave = {
                ticker_text: tickerText,
                categories: menuData
            };
            if (validatePrices()) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(dataToSave));
                showStatus('✅ تم الحفظ تلقائياً في المتصفح');
                hideError();
            } else {
                showError();
            }
        }

        document.getElementById('save-btn').addEventListener('click', () => {
            if (!validatePrices()) {
                showError();
                alert('⚠️ لا يمكن الحفظ: توجد خانات سعر فارغة. الرجاء تعبئة جميع الأسعار.');
                return;
            }
            const dataToSave = {
                ticker_text: tickerText,
                categories: menuData
            };
            const jsonStr = JSON.stringify(dataToSave, null, 4);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'menu.json';
            a.click();
            URL.revokeObjectURL(url);
            alert('تم تجهيز الملف! ارفعه إلى GitHub في نفس مجلد menu.json.');
        });

        document.getElementById('copy-btn').addEventListener('click', () => {
            if (!validatePrices()) {
                showError();
                alert('⚠️ لا يمكن النسخ: توجد خانات سعر فارغة. الرجاء تعبئة جميع الأسعار.');
                return;
            }
            const dataToSave = {
                ticker_text: tickerText,
                categories: menuData
            };
            const jsonStr = JSON.stringify(dataToSave, null, 4);
            navigator.clipboard.writeText(jsonStr).then(() => {
                alert('تم نسخ JSON بنجاح');
            }).catch(() => {
                alert('تعذر النسخ. انسخ يدوياً من النص.');
            });
        });
    </script>
</body>
</html>